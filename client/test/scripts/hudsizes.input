# HUD layout at the four viewport sizes of #1003: no overlaps or off-screen parts,
# and the belt takes at most half the viewport width. The scale is the shared rule,
# interfaceScale (client/uipx.js): min(belt-width limit, viewport height / 160, 100x65 panel fit). Each case carries seeds,
# so the hands label exists, and checks that the hands label, timer and slot numbers are on screen.

case hud fits a phone in portrait (390x844)
start walk raft
click
lock
mouse 632 120
frame 50 x2
button down right
button up right
frame 50 x2
expect hands = seeds
layout 390 844
expect layout.scale = 3
expect layout.problems = 0
expect layout.belt.fraction <= 0.5
expect layout.timer = inside
expect layout.slotnumbers = inside
expect layout.hands.label = inside

case hud fits a laptop (1366x768)
start walk raft
click
lock
mouse 632 120
frame 50 x2
button down right
button up right
frame 50 x2
expect hands = seeds
layout 1366 768
expect layout.scale = 4
expect layout.problems = 0
expect layout.belt.fraction <= 0.5
expect layout.timer = inside
expect layout.slotnumbers = inside
expect layout.hands.label = inside

